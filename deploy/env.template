# /etc/tiptop/@ENVIRONMENT@.env — read by the systemd units and deploy.sh. Created by setup.sh; edit by hand afterwards.
DJANGO_SETTINGS_MODULE=tiptop.settings.prod
ENVIRONMENT=@ENVIRONMENT@
DJANGO_SECRET_KEY=@SECRET@
DJANGO_ALLOWED_HOSTS=@HOSTS@
DJANGO_CSRF_TRUSTED_ORIGINS=@URL@
SITE_URL=@URL@
DATABASE_URL=postgres://@DB@:@DBPASS@@127.0.0.1:5432/@DB@
REDIS_URL=redis://127.0.0.1:6379/@RDB@
CELERY_BROKER_URL=redis://127.0.0.1:6379/@RDB1@
CACHE_PREFIX=tt-@ENVIRONMENT@
# staging runs background jobs inline (no worker) to save memory
CELERY_TASK_ALWAYS_EAGER=@EAGER@
STATIC_ROOT=@BASE@/static
MEDIA_ROOT=@BASE@/media
PRIVATE_ROOT=@BASE@/private
LOG_FILE=/var/log/tiptop/@ENVIRONMENT@.log
GUNICORN_WORKERS=@WORKERS@

# --- fill in (see docs/RUNBOOK.md) ---
# Brevo (EU) API key for transactional email; the withdrawal confirmation depends on it
BREVO_API_KEY=
DEFAULT_FROM_EMAIL="TipTop Service 24 <info@tiptophandyreparatur.de>"
SERVER_EMAIL="TipTop Website <noreply@tiptophandyreparatur.de>"
# Google Places API (New) key, restricted to the Places API and this server's IP
GOOGLE_PLACES_API_KEY=
# Google service account JSON for Sheets (chmod 640 root:tiptop)
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/tiptop/google-service-account.json
# Error tracking, EU region (e.g. https://...@o0.ingest.de.sentry.io/0)
SENTRY_DSN=
