# Copy to app/.env for local development. In staging/production these live in /etc/tiptop/<env>.env (see deploy/).
DJANGO_SETTINGS_MODULE=tiptop.settings.dev
DJANGO_SECRET_KEY=change-me
# PostgreSQL, e.g. postgres://tiptop:password@localhost:5432/tiptop  (without it, dev uses SQLite)
DATABASE_URL=
# Redis for cache and Celery, e.g. redis://localhost:6379/0  (without it, tasks run inline and the cache is in memory)
REDIS_URL=
SITE_URL=http://localhost:8000
# Email: console in dev; Brevo in production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=TipTop Service 24 <info@tiptophandyreparatur.de>
# Google
GOOGLE_PLACES_API_KEY=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Error tracking (EU region DSN)
SENTRY_DSN=
# Set to 1 to require two-factor sign-in locally as well
OTP_ENFORCE=0
