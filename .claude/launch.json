{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "django",
      "runtimeExecutable": "app/.venv/Scripts/python.exe",
      "runtimeArgs": ["app/manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    },
    {
      "name": "prototype",
      "runtimeExecutable": "app/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8001", "--bind", "127.0.0.1", "--directory", "prototype"],
      "port": 8001
    }
  ]
}
